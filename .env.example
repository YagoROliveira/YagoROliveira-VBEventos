# API
NODE_ENV=development
API_PORT=3000
# Host mapping in docker-compose: 3002 -> 3000 (3000 often occupied locally)
API_HOST=0.0.0.0
DATABASE_URL=postgresql://events:events@localhost:5432/events?schema=public
SQIDS_ALPHABET=abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789
SQIDS_MIN_LENGTH=8
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:8081,http://localhost:5173
RUN_MIGRATIONS=true
API_UPSTREAM=api:3000
API_KEY=dev-events-api-key

# Web (Vite / Nginx)
VITE_API_BASE_URL=/api/v1
WEB_PORT=5173
